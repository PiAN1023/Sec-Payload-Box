{
  "manifest_version": 3,
  "name": "Web安全Payload速查工具箱",
  "version": "1.0.0",
  "description": "离线速查14大类Web安全Payload，支持检索、收藏、自定义、批量管理与编码转换，适用于护网、CTF与渗透测试。",
  "minimum_chrome_version": "88",
  "permissions": ["storage", "downloads"],
  "action": {
    "default_title": "Web安全Payload速查工具箱",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
